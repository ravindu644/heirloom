<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12 the launch window shows this: the mark on ground, plain. From 12 on the
     system draws its own splash from the theme in styles.xml, with the same two. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ground" />
    <item android:drawable="@drawable/mark" android:gravity="center" android:width="144dp" android:height="144dp" />
</layer-list>
