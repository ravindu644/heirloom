# machine-specific details: addresses, logins, adb serials
.local/*
!.local/ENV.example.md

# build output
node_modules/
dist/
client/dist/
client/dist-app/
server/bin/
# The app is copied here for go:embed. Only the placeholder is kept, so a fresh clone still builds.
!server/web/dist/
server/web/dist/*
!server/web/dist/.keep
android/app/build/
android/.gradle/
*.apk
*.aab
*.keystore
*.jks

# generated from DESIGN.md
client/src/ui/tokens.css

# test output
test-results/
playwright-report/
reviews/*/shots/
reviews/*/frames/
# pictures from a real phone carry its owner's status bar
reviews/*/device/

# secrets
.env
.env.*

# other people's work, kept locally for re-checking, never committed
design/refs/
docs/research/pages/
.claude/worktrees/
