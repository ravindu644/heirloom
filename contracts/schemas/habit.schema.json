{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "habit",
  "description": "One row per habit.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "days": { "type": "integer", "minimum": 1, "maximum": 127, "description": "Weekday mask. Bit 0 is Monday, bit 6 is Sunday." },
    "target": { "type": "integer", "minimum": 1, "description": "Check-ins that make the day done." },
    "remind": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Local time of day for the reminder, 24 hour, 07:30. Null for none." },
    "order": { "type": "string" },
    "archived": { "type": ["integer", "null"] },
    "deleted": { "type": ["integer", "null"] }
  }
}
