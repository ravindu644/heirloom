{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project",
  "description": "One row per project.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "color": { "enum": ["you", "rest", "ink", "ghost", "heat-2"], "description": "A DESIGN.md colour role. DESIGN.md says why only these." },
    "order": { "type": "string" },
    "archived": { "type": ["integer", "null"], "description": "Server-time ms, null while active." },
    "deleted": { "type": ["integer", "null"] }
  }
}
